### === INACTIVE -- NO-VC VARIANT (.off) === Victoria 3 does not load
### unrecognized file extensions, so this file does nothing while named
### "zzzz_llwa_kai_vc_reforms.txt.off". Same three reform strategies, KAI's own records only,
### WITHOUT Victorian Century's layer. Rename it to
### "zzzz_llwa_kai_vc_reforms.txt" (replacing the active file) if you use addon-LLWA
### WITHOUT Victorian Century.

# LLWA x Kuromi's AI x VC compatch -- KAI's own three reform strategies (no-VC variant)
# Generated by tools/regen_llwa_kai.py on 2026-08-26. Do not hand-edit: the next
# run overwrites this file. Change the generator instead.
#
# Load order: Kuromi's AI -> ... -> Victorian Century -> addon-VC (incl.
# _vc/kai+vc done) -> ... -> LLWA -> 03_political_strategies.txt (this
# folder) -> THIS.
# Why this file exists: ai_strategy_great_reforms, _tanzimat_reforms and
# _meiji_restoration are shared three ways -- KAI, VC, and LLWA (LLWA.2 AND
# LLWA.3 in the plan, same three keys). addon-VC already carries a closed,
# verified three-way merge for exactly these three
# (_vc/kai+vc done/common/ai_strategies/zz_vc_kai_ai_strategies.txt) --
# LLWA's stale 03_political_strategies.txt wipes it along with everything
# else at that path. Rather than re-derive the same merge a second time,
# this file copies that compatch's own record bodies verbatim (read live,
# not hand-pasted) and reissues them here, after the vanilla restore. Also
# serves the ai_strategies half of the LLWA x VC pair -- see
# _llwa/llwa+vc done/README.md, which points back here instead of writing
# these same three keys a second time.

INJECT:ai_strategy_great_reforms = {
	revolution_aversion = {
		value = 67.5
	}
}

INJECT:ai_strategy_tanzimat_reforms = {
	revolution_aversion = {
		value = 67.5
	}
}

REPLACE_OR_CREATE:ai_strategy_meiji_restoration = {
	icon = "gfx/interface/icons/ai_strategy_icons/progressive_agenda.dds"

	type = political

	revolution_aversion = {
		value = 67.5
	}

	min_law_chance_to_pass = {
		value = 10
		if = {
			limit = { ai_has_reasons_to_not_oppose_law = yes }
			multiply = 0.5
		}
	}

	max_progressiveness = {
		value = 100
		if = {
			limit = { has_enactment_je_or_law_commitment = yes }
			multiply = 1.5
		}
	}

	max_regressiveness = {
		value = 50
	}

	change_law_chance = {
		value = 50
	}

	pro_interest_groups = {
		ig_intelligentsia
		ig_industrialists
	}

	anti_interest_groups = {
		ig_landowners
		# Use interest_group_government_weight to handle Retire the Samurai
		# ig_armed_forces
	}

	pro_movements = {
		movement_liberal
		movement_modernizer
		movement_anti_slavery
		movement_land_reform
		movement_positivist
		movement_utilitarian
		movement_feminist
		movement_corporatist
		movement_radical
		movement_royalist_absolutist
		movement_royalist_constitutional
		movement_religious_majority
		movement_cultural_majority
	}

	anti_movements = {
		movement_socialist
		movement_communist
		movement_anarchist
		movement_nihilist
		movement_fascist
		movement_reactionary
		movement_pro_slavery
		movement_religious_minority
		movement_cultural_minority
	}

	institution_scores = {
		institution_colonial_affairs = {
			value = 75
			if = {
				limit = {
					has_journal_entry = je_colonize_korea
				}
				multiply = 2
			}
		}
		institution_social_security = {
			value = 100
		}
		institution_workplace_safety = {
			value = 100
		}
		institution_schools = {
			value = 1000
		}
		institution_police = {
			value = 75
		}
		institution_health_system = {
			value = 100
		}
		institution_home_affairs = {
			value = 100
		}
	}

	interest_group_government_weight = {
		value = 0

		if = {
			limit = {
				has_journal_entry = je_meiji_army
				scope:interest_group = {
					is_interest_group_type = ig_armed_forces
				}
			}
			add = -1.5
		}
	}

	possible = {
		# The strategy should be available as soon as the emperor is restored
		OR = {
			has_journal_entry = je_meiji_restoration
			has_journal_entry = je_meiji_main
		}
		# It would be difficult to form a legitimate government with the conservative emperors before Meiji
		ruler ?= {
			has_template = JAP_meiji_yamato
		}
	}

	weight = {
		value = 10000
	}
}
