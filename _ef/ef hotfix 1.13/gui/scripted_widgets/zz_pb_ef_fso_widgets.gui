								align = nobaseline
								autoresize = yes
								max_width = 230
								elide = right
								fontsize_min = 14
								text = "speculative_share_10_button"
							}

							icon = {
								using = highlighted_square_selection
							}
						}
					}
					flowcontainer = {
						direction = horizontal
						spacing = 10
						parentanchor = hcenter
						button = {
							using = default_button_action
							tooltip = "speculative_share_11_button_tt"
							enabled = "[GetScriptedGui('speculative_share_11_button').IsValid( GuiScope.SetRoot(GetPlayer.MakeScope ).End)]"
							onclick = "[GetScriptedGui('speculative_share_11_button').Execute( GuiScope.SetRoot(GetPlayer.MakeScope ).End)]"
							size = { 250 50 }
