# CMF hook: placed by the journal entry in CMF's
# com_custom_widget_container_scripted_progress_bars, which makes CMF skip the
# entry's default scripted progress bars in the panel. Empty on purpose.
widget = {
	name = "zz_pb_ef_fso_hide_bars_widget"
	size = { 0 0 }
}
