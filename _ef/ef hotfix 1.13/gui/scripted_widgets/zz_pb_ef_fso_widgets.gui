					}
				}
				### pb+ef: ban / allow private construction sectors, then E&F's 9-12
				### ("build 5 / 10 / 15 / 20 sectors"). 9-12 are always shown since
				### 2026-09-25 (E&F shows them only while the index is 0, PCS_growing_visibility);
				### their own is_valid still requires index 0, so above zero they are
				### greyed out with E&F's tooltip. Button 13 is dropped (it demolished
				### building_ef_private_construction, which PSC does not have).
				flowcontainer = {
					direction = vertical
					spacing = 10
					parentanchor = hcenter
					ignoreinvisible = yes
					textbox = {
						visible = "[GetScriptedGui('zz_pb_ef_fso_ob_banned').IsShown( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						text = "zz_pb_ef_fso_overcap_banned"
						autoresize = yes
						multiline = yes
						minimumsize = { @panel_width_minus_20 -1 }
						maximumsize = { @panel_width_minus_20 -1 }
						using = default_list_position
						align = hcenter|nobaseline
						using = fontsize_large
					}
					button = {
						visible = "[GetScriptedGui('zz_pb_ef_css_private_ban_sgui').IsShown( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						parentanchor = hcenter
						using = default_button_action
						tooltip = "zz_pb_ef_css_private_ban_button_desc"
						enabled = "[GetScriptedGui('zz_pb_ef_css_private_ban_sgui').IsValid( GuiScope.SetRoot(GetPlayer.MakeScope ).End)]"
						onclick = "[GetScriptedGui('zz_pb_ef_css_private_ban_sgui').Execute( GuiScope.SetRoot(GetPlayer.MakeScope ).End)]"
						size = { 400 50 }
						margin = { 20 20 }

						textbox = {
							parentanchor = center
							align = nobaseline
							autoresize = yes
							max_width = 380
							elide = right
							fontsize_min = 14
							text = "zz_pb_ef_css_private_ban_button"
						}

						icon = {
							using = highlighted_square_selection
						}
					}
					button = {
						visible = "[GetScriptedGui('zz_pb_ef_css_private_allow_sgui').IsShown( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						parentanchor = hcenter
						using = default_button_action
						tooltip = "zz_pb_ef_css_private_allow_button_desc"
						enabled = "[GetScriptedGui('zz_pb_ef_css_private_allow_sgui').IsValid( GuiScope.SetRoot(GetPlayer.MakeScope ).End)]"
						onclick = "[GetScriptedGui('zz_pb_ef_css_private_allow_sgui').Execute( GuiScope.SetRoot(GetPlayer.MakeScope ).End)]"
						size = { 400 50 }
						margin = { 20 20 }

						textbox = {
							parentanchor = center
							align = nobaseline
							autoresize = yes
							max_width = 380
							elide = right
							fontsize_min = 14
							text = "zz_pb_ef_css_private_allow_button"
						}

						icon = {
							using = highlighted_square_selection
						}
					}
					flowcontainer = {
						direction = horizontal
						spacing = 10
						parentanchor = hcenter
						button = {
							using = default_button_action
							tooltip = "speculative_share_9_button_tt"
							enabled = "[GetScriptedGui('speculative_share_9_button').IsValid( GuiScope.SetRoot(GetPlayer.MakeScope ).End)]"
							onclick = "[GetScriptedGui('speculative_share_9_button').Execute( GuiScope.SetRoot(GetPlayer.MakeScope ).End)]"
							size = { 250 50 }
							margin = { 20 20 }

							textbox = {
								parentanchor = center
								align = nobaseline
								autoresize = yes
								max_width = 230
								elide = right
								fontsize_min = 14
								text = "speculative_share_9_button"
							}

							icon = {
								using = highlighted_square_selection
							}
						}
						button = {
							using = default_button_action
							tooltip = "speculative_share_10_button_tt"
							enabled = "[GetScriptedGui('speculative_share_10_button').IsValid( GuiScope.SetRoot(GetPlayer.MakeScope ).End)]"
							onclick = "[GetScriptedGui('speculative_share_10_button').Execute( GuiScope.SetRoot(GetPlayer.MakeScope ).End)]"
							size = { 250 50 }
							margin = { 20 20 }

							textbox = {
