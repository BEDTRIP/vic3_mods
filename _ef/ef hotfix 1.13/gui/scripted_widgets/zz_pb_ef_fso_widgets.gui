						button = {
							using = default_button_action
							tooltip = "speculative_share_12_button_tt"
							enabled = "[GetScriptedGui('speculative_share_12_button').IsValid( GuiScope.SetRoot(GetPlayer.MakeScope ).End)]"
							onclick = "[GetScriptedGui('speculative_share_12_button').Execute( GuiScope.SetRoot(GetPlayer.MakeScope ).End)]"
							size = { 250 50 }
