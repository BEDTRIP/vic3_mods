#pcs_fso_situation
flowcontainer = {
	name = "zz_pb_ef_fso_overcap_widget"
	ignoreinvisible = yes

	flowcontainer = {
		direction = vertical

		section_header_button = {
			blockoverride "left_text" {
				text = "pcs_fso_situation"
			}

			### pb+ef: open by default (2026-09-25) -- the variable now means "closed".
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('zz_pb_ef_fso_overcap_closed')]"
			}

			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('zz_pb_ef_fso_overcap_closed')]"
			}

			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('zz_pb_ef_fso_overcap_closed'))]"
			}
		}
		flowcontainer = {
			using = default_list_position
			direction = vertical
			visible = "[Not(GetVariableSystem.Exists('zz_pb_ef_fso_overcap_closed'))]"
			margin_top = 10

			flowcontainer = {
				direction = vertical
				parentanchor = hcenter
				spacing = 10
				ignoreinvisible = yes

				bad_progressbar_horizontal = {
					block "progressbar_size" {
						size = { 504 30 }
					}
					blockoverride "values" {
						value = "[GetPlayer.MakeScope.Var('speculative_share_2').GetValue]"
						min = 0
						max = 100
					}
					textbox = {
						text = "zz_pb_ef_fso_overcap_bar"
						autoresize = yes
						align = nobaseline
						margin_left = 10
						parentanchor = vcenter
					}
				}

				### pb+ef: the numbers, as a 2 x 4 table in the style of E&F's budget tiles
				### (gui/00_ef_deported_gui_1.gui, info_finance_main): label over value.
