								parentanchor = hcenter
								multiline = yes
								fontsize = 18
								minimumsize = { 105 -1 }
								maximumsize = { 105 -1 }
							}
						}
						flowcontainer = {
							direction = vertical
							spacing = 5
							ignoreinvisible = yes
							minimumsize = { 105 95 }
							maximumsize = { 105 -1 }
							background = {
								using = entry_bg_simple
