					autoresize = yes
					multiline = yes
					minimumsize = { @panel_width_minus_20 -1 }
					maximumsize = { @panel_width_minus_20 -1 }
					using = default_list_position
					align = hcenter|nobaseline
					using = fontsize_large
				}
				textbox = {
					visible = "[GetScriptedGui('zz_pb_ef_fso_bb_dyn_down').IsShown( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					text = "zz_pb_ef_fso_bubble_dyn_down"
					autoresize = yes
					multiline = yes
					minimumsize = { @panel_width_minus_20 -1 }
					maximumsize = { @panel_width_minus_20 -1 }
					using = default_list_position
					align = hcenter|nobaseline
					using = fontsize_large
				}
				textbox = {
					visible = "[GetScriptedGui('zz_pb_ef_fso_bb_dyn_zero').IsShown( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
