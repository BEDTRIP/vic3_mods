#############################################
# EF.18 v2 (2026-09-24) -- the two sections of E&F's Financial Stability Office
# journal (financial_center_je_2), rebuilt. Came from the E&F x PSC compatch,
# which lives inside this hotfix since 2026-10-02 (СТР.6).
#
# Built from E&F's widget_je_ef_fc_fso_situation / widget_je_ef_pcs_fso_situation
# (gui/scripted_widgets/00_ef_custom_widgets.gui, 4.1.7) -- headers and E&F's
# buttons 1-12 are E&F's, copied as they are. Changes, in each section:
#   bars      each section has its own bar, read from the variable. The
#             journal entry's scripted bars are on too, for the outliner only;
#             in the panel CMF's hook turns them off (the empty
#             zz_pb_ef_fso_hide_bars_widget at the end of this file);
#   values    computed live: bubble -- the speculative share of GDP and this
#             month's change of the bubble; overcapacity -- a 2 x 4 table
#             (sectors, urban centres, rate, limit / ratio to the limit,
#             target penalty, monthly change, current penalty). Red = bad
#             (over the limit, index rising), green = good;
#   buttons   bubble: E&F's 1-8 unchanged. Overcapacity: ban / allow private
#             sectors first, then E&F's 9-12, always shown
#             (scripted_guis/zz_pb_ef_fso_sguis.txt); E&F's 13 dropped (it
#             demolished a building PSC does not have);
#   headers   both sections open by default (E&F's start closed);
#   text      the explanation of each mechanism, inside its own section, so it
#             folds with it (it used to be the journal's single reason text,
#             below both sections, bubble and construction mixed).
# Constants below are E&F's (a .gui file's @constants are file-local).
#############################################

# COPY-PASTED FOR NOW
@panel_width_minus_30 = 510
@panel_width_minus_20 = 520
@panel_width_minus_10 = 530			# used to be 450
@panel_width = 540  				# used to be 460
@panel_width_half = 270				# used to be 230
@panel_width_plus_10 = 550  		# used to be 470
@panel_width_plus_14 = 554			# used to be 474
@panel_width_plus_14_half = 277		# used to be 237
@panel_width_plus_20 = 560			# used to be 480
@panel_width_plus_30 = 570			# used to be 490
@panel_width_plus_70 = 610			# used to be 530

### WIDGETS

#fc_fso_situation
flowcontainer = {
	name = "zz_pb_ef_fso_bubble_widget"
	ignoreinvisible = yes

	flowcontainer = {
		direction = vertical
 
		#fc_fso_situation
		section_header_button = {
			blockoverride "left_text" {
				text = "fc_fso_situation"
			}

			### pb+ef: open by default (2026-09-25) -- the variable now means "closed".
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('zz_pb_ef_fso_bubble_closed')]"
			}

			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('zz_pb_ef_fso_bubble_closed')]"
			}

			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('zz_pb_ef_fso_bubble_closed'))]"
			}
		}
		flowcontainer = {
			using = default_list_position
			direction = vertical
			visible = "[Not(GetVariableSystem.Exists('zz_pb_ef_fso_bubble_closed'))]"
			margin_top = 10
  
			flowcontainer  = {
				margin_top = 0
				margin_right = 0
				margin_left = 0
				margin_bottom = 10

				spacing = 10

				direction = vertical

				parentanchor = hcenter

				### pb+ef: the section's own bar, read straight from the variable (no
				### ScriptedProgressBar context here, so no breakdown tooltip).
				bad_progressbar_horizontal = {
					block "progressbar_size" {
						size = { 504 30 }
					}
					blockoverride "values" {
						value = "[GetPlayer.MakeScope.Var('speculative_share_1').GetValue]"
						min = 0
						max = 100
					}
					textbox = {
						text = "zz_pb_ef_fso_bubble_bar"
						autoresize = yes
						align = nobaseline
						margin_left = 10
						parentanchor = vcenter
					}
				}
### pb+ef: computed values, then the buttons, then the explanation.
				textbox = {
					text = "zz_pb_ef_fso_bubble_share"
					autoresize = yes
					multiline = yes
					minimumsize = { @panel_width_minus_20 -1 }
					maximumsize = { @panel_width_minus_20 -1 }
					using = default_list_position
					align = hcenter|nobaseline
					using = fontsize_large
				}
				textbox = {
					visible = "[GetScriptedGui('zz_pb_ef_fso_bb_dyn_up').IsShown( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
