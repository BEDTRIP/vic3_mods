														layoutpolicy_horizontal = expanding
													datacontext = "[Scope.GetCompany]"

														text = "[Company.MakeScope.ScriptValue('ai_privat_bank_interest_calculated_25_from_list')|-=D] @gold!"

														margin_left = 12
														margin_bottom = 1
														elide = right
														align = left|nobaseline
														parentanchor = left
														alwaystransparent = yes
													}
												}
											}
										}
									}
