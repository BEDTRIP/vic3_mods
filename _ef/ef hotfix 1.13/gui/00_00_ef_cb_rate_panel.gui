			#financial_product info total
			section_header_button = {
				#visible = "[Not(IsDataModelEmpty(AccessPlayer.GetAvailableCompanies))]"

				blockoverride "left_text" {
					text = "financial_product_panel"
				}

				blockoverride "onclick" {
					onclick = "[GetVariableSystem.Toggle('financial_product')]"
					onclick = "[GetScriptedGui('update_financial_product_list').Execute( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

