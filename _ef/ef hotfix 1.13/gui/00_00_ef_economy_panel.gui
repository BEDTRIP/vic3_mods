						flowcontainer = {
							using = default_list_position
							visible = "[GetVariableSystem.Exists('currency_reserves')]"

							margin_top = 25
							margin_right = -75
							margin_left = 75
							margin_bottom = 10

							parentanchor = left|nobaseline

							dynamicgridbox = {
								datamodel = "[GetGlobalList('stored_currency')]"

								flipdirection = yes
								datamodel_wrap = 4

								parentanchor = left|nobaseline

								position = { 0 0 }

								item = {
									flowcontainer = {
										margin_top = 0
										margin_right = 0
										margin_left = 25
										margin_bottom = 25

										spacing = 1
										using = tooltip_below

										parentanchor = hcenter

										flowcontainer = {
											spacing = 1
											direction = vertical

											background = {
												using = entry_bg_simple
												margin = { 10 10 }
											}

											datacontext = "[Scope.GetCountry]"

											tooltip =  "per_week"
											using = tooltip_below

											textbox = {
												using = fontsize_large
												autoresize = yes
												text = "[Localize(Concatenate(Scope.GetFlagName,'_name_currency'))]"
												parentanchor = hcenter
												align = hcenter|nobaseline
												elide = right
												maximumsize = { 105 -1 }
											}
											textbox = {
												using = fontsize_large
												autoresize = yes
												text = "[Localize(Concatenate(Scope.GetFlagName,'_name_player_country'))]"
												parentanchor = hcenter
												align = hcenter|nobaseline
												elide = right
												maximumsize = { 100 -1 }
											}
											textbox = {
												using = fontsize_large
												autoresize = yes
												text = "[Localize(Concatenate(Scope.GetFlagName,'_name_accumulation_player_country'))]"
												parentanchor = hcenter
												align = hcenter|nobaseline
												elide = right
												maximumsize = { 100 -1 }
											}

											minimumsize = { 100 40 }
											maximumsize = { 100 -1 }
										}
									}
								}
							}
						}
