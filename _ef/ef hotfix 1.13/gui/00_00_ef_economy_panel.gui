								margin_top = 10

								item = {
									button = {
										using = default_button
										size = { @panel_width 60 }

										hbox = {
											margin = { 12 0 }

											textbox = {
												layoutstretchfactor_horizontal = 1
												layoutpolicy_horizontal = expanding

												datacontext = "[Scope.GetCountry]"

												text = "[Country.GetName]"

												margin_left = 5
												margin_bottom = 1
