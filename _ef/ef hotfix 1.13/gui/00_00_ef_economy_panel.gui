						#transfer_government_treasury_to_central_bank_metal_reserves
						section_header_button = {
							#visible = "[Not(IsDataModelEmpty(AccessPlayer.GetAvailableCompanies))]"

							blockoverride "left_text" {
								text = "transfer_government_treasury_to_central_bank_metal_reserves"
							}

							blockoverride "onclick" {
								onclick = "[GetVariableSystem.Toggle('transfer_government_treasury_to_central_bank_metal_reserves')]"
								onclick = "[GetScriptedGui('transfer_government_treasury_to_central_bank_metal_reserves_list_gerenation_ordered').Execute( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

							}

							blockoverride "onclick_showmore" {
								visible = "[Not(GetVariableSystem.Exists('transfer_government_treasury_to_central_bank_metal_reserves'))]"
							}

							blockoverride "onclick_showless" {
								visible = "[GetVariableSystem.Exists('transfer_government_treasury_to_central_bank_metal_reserves')]"
							}
						}
						flowcontainer = {
							using = default_list_position
							direction = vertical
							visible = "[GetVariableSystem.Exists('transfer_government_treasury_to_central_bank_metal_reserves')]"
							margin_top = 10

							#monetary_policy_tools_no
							flowcontainer = {
								visible = "[GetScriptedGui('no_has_monetary_policy_tools_tech_visibility').IsShown( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

								margin_top = 0
								margin_right = 0
								margin_left = 0

								parentanchor = hcenter

								spacing = 15

								direction = vertical


								textbox = {
									margin_bottom = 5

									autoresize = yes
									text = "you_need_monetary_policy_tools"
									parentanchor = hcenter

									align = hcenter
									elide = right
									default_format = "#white #bold"
									autoresize = yes
									fontsize = 20
									allow_outside = no
									ignoreinvisible = yes
