											onclick = "[GetVariableSystem.Clear('un_panel')]"
											onclick = "[GetVariableSystem.Clear('international_open')]"

											parentanchor = left
											align = left|nobaseline
											elide = right
										}
									}
									flowcontainer = {
										datacontext = "[Scope.GetCountry]"

										spacing = 5
										direction = vertical
										textbox = {
											text = "#v [Country.GetCustom('currency_name')]#!"
											default_format = "#white #bold"
											autoresize = yes
											fontsize = 15
											allow_outside = yes
											ignoreinvisible = yes
											# minimumsize = { 250 40 }
											# maximumsize = { 250 -1 }
											# elide = right
										}
										textbox = {
											datacontext = "[Scope.GetCountry]"

											text = "[Country.MakeScope.ScriptValue('money_value_dif_1_final')|%|+=]"
											default_format = "#white #bold"
											autoresize = yes
											fontsize = 15
											allow_outside = yes
											ignoreinvisible = yes
										}
									}
								}
							}
						}
					}

					divider_decorative = {
					}

					flowcontainer = {
						datamodel = "[GetPlayer.MakeScope.GetList('evolution_currency_value_1_country_1')]"

						# parentanchor = hcenter

						item = {
							flowcontainer = {
								datacontext = "[Scope.GetCountry]"

								textbox = {
									text = "evolution_currency_value_txt"
									align = hcenter|nobaseline

									elide = left
 									autoresize = yes
									fontsize = 20
									allow_outside = yes
									ignoreinvisible = yes
									multiline = yes

									minimumsize = { 520 30 }
									maximumsize = { 520 -1 }
								}
							}
						}
					}
				}

				section_header_button = {
					#visible = "[Not(IsDataModelEmpty(AccessPlayer.GetAvailableCompanies))]"

					blockoverride "left_text" {
						text = "SHOW_LIST"
					}

					blockoverride "onclick" {
						onclick = "[GetVariableSystem.Toggle('EVOLUTION_OF_THE_CURRENCY_VALUE_TITLE')]"
						onclick = "[GetScriptedGui('EVOLUTION_OF_THE_CURRENCY_VALUE_TITLE_list_gerenation_ordered').Execute( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

					}

					blockoverride "onclick_showmore" {
						visible = "[Not(GetVariableSystem.Exists('EVOLUTION_OF_THE_CURRENCY_VALUE_TITLE'))]"
					}

					blockoverride "onclick_showless" {
						visible = "[GetVariableSystem.Exists('EVOLUTION_OF_THE_CURRENCY_VALUE_TITLE')]"
					}
				}
				flowcontainer = {
					using = default_list_position
					direction = vertical
					visible = "[GetVariableSystem.Exists('EVOLUTION_OF_THE_CURRENCY_VALUE_TITLE')]"
					margin_top = 0
					margin_bottom = 0

					flowcontainer = {
						using = default_list_position
						direction = vertical

						widget = {
							size = { @panel_width 30 }

							hbox = {
								sort_button = {
									layoutpolicy_horizontal = preferred
									size = { 110 20 }
									align = hcenter|nobaseline
									text = "COUNTRY_TITLE"
									datacontext = "[GetScriptedGui('cv_sort_by_country_gdp')]"
									onclick = "[ScriptedGui.Execute(GuiScope.AddScope('player_country', GetPlayer.MakeScope).End )]"
								}
								sort_button = {
									layoutpolicy_horizontal = preferred
									align = hcenter|nobaseline
									size = { 105 20 }
									text = "growth_1_year"
									datacontext = "[GetScriptedGui('cv_evolution_1_year')]"
									onclick = "[ScriptedGui.Execute(GuiScope.AddScope('player_country', GetPlayer.MakeScope).End )]"
								}
								sort_button = {
									layoutpolicy_horizontal = preferred
									align = hcenter|nobaseline
									size = { 105 20 }
									text = "growth_5_year"
									datacontext = "[GetScriptedGui('cv_evolution_5_year')]"
									onclick = "[ScriptedGui.Execute(GuiScope.AddScope('player_country', GetPlayer.MakeScope).End )]"
								}
								sort_button = {
									layoutpolicy_horizontal = preferred
									align = hcenter|nobaseline
									size = { 105 20 }
									text = "growth_10_year"
									datacontext = "[GetScriptedGui('cv_evolution_10_year')]"
									onclick = "[ScriptedGui.Execute(GuiScope.AddScope('player_country', GetPlayer.MakeScope).End )]"
								}
							}
						}

						flowcontainer = {
							direction = vertical
							datamodel = "[GetGlobalList('currency_value_evolution_list_ordered_1')]"

							margin_top = 10

							item = {
								button = {
									using = default_button
									size = { @panel_width 40 }

									hbox = {
										margin = { 12 0 }

										textbox = {
											layoutstretchfactor_horizontal = 1
											layoutpolicy_horizontal = expanding

											datacontext = "[Scope.GetCountry]"

											text = "[Country.GetName]"
											margin_left = 0
											margin_bottom = 1
											elide = right
											align = left|nobaseline
											parentanchor = left|nobaseline
											alwaystransparent = yes
										}

										vertical_divider = {}

										textbox = {
											layoutstretchfactor_horizontal = 1
											layoutpolicy_horizontal = expanding
											datacontext = "[Scope.GetCountry]"

											text = "[Country.MakeScope.ScriptValue('money_value_dif_1_final')|%|+=]"
											margin_left = 0
											margin_bottom = 1
											elide = right
											align = hcenter|nobaseline
											parentanchor = left|nobaseline
											alwaystransparent = yes
										}

										vertical_divider = {}

										textbox = {
											layoutstretchfactor_horizontal = 1
											layoutpolicy_horizontal = expanding
											datacontext = "[Scope.GetCountry]"

											text = "[Country.MakeScope.ScriptValue('money_value_dif_5_final')|%|+=]"
											margin_left = 0
											margin_bottom = 1
											elide = right
											align = hcenter|nobaseline
											parentanchor = left|nobaseline
											alwaystransparent = yes
										}

										vertical_divider = {}

										textbox = {
											layoutstretchfactor_horizontal = 1
											layoutpolicy_horizontal = expanding
											datacontext = "[Scope.GetCountry]"

											text = "[Country.MakeScope.ScriptValue('money_value_dif_10_final')|%|+=]"
											margin_left = 0
											margin_bottom = 1
											elide = right
											align = hcenter|nobaseline
											parentanchor = left|nobaseline
											alwaystransparent = yes
										}
