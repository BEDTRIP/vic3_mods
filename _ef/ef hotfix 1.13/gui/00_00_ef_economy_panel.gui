								visible = "[GetScriptedGui('has_monetary_policy_tools_tech_visibility').IsShown( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

								margin_top = 0
								margin_right = 0
								margin_left = 0

								parentanchor = hcenter

								spacing = 15

								direction = vertical

								#button
