									margin_left = 0
									margin_bottom = 0

									spacing = 5
									direction = vertical

									textbox = {
										using = fontsize_large
										autoresize = yes
										text = "silver_price_in_gold"
										parentanchor = hcenter
										align = hcenter

										multiline = yes
										minimumsize = { 225 40 }
										maximumsize = { 225 -1 }
									}
									textbox = {
										using = fontsize_large
										autoresize = yes
										text = "1 @silver! = [GetPlayer.MakeScope.ScriptValue('silver_to_gold_rate')] @gold!"
										parentanchor = hcenter
										align = vcenter
										default_format = "#white #bold"
									}
									background = {
										using = entry_bg_simple
										margin = { 5 10 }
									}
									minimumsize = { 225 40 }
									maximumsize = { 225 -1 }
								}

							}
							flowcontainer  = {
								margin_top = 0
								margin_right = 0
								margin_left = 0
								margin_bottom = 20

								spacing = 15

								direction = horizontal

								parentanchor = hcenter

								flowcontainer  = {
									margin_top = 0
									margin_right = 0
									margin_left = 0
									margin_bottom = 0

									spacing = 5
									direction = vertical

									textbox = {
										using = fontsize_large
										autoresize = yes
										text = "[GetPlayer.GetCustom('metal_barometre')]"
										parentanchor = hcenter
										align = vcenter
										default_format = "#white #bold"
									}
									background = {
 										alpha = 0.5
										using = entry_bg_fancy_dark

										margin = { 5 10 }
									}
									minimumsize = { 500 30 }
									maximumsize = { 500 -1 }
								}

							}

							divider_decorative = {
							}

							flowcontainer = {
								using = default_list_position
								direction = vertical
								#margin_top = 10
								margin_bottom = 10

								widget = {
									size = { @panel_width 30 }

									hbox = {
										sort_button = {
											layoutpolicy_horizontal = preferred
											size = { 200 20 }
											align = hcenter|nobaseline
											text = "monetary_systeme"
											datacontext = "[GetScriptedGui('cv_sort_by_country_gdp')]"
											onclick = "[ScriptedGui.Execute(GuiScope.AddScope('player_country', GetPlayer.MakeScope).End )]"
										}
										sort_button = {
											layoutpolicy_horizontal = preferred
											align = hcenter|nobaseline
											size = { 100 20 }
											text = "MVT"
											datacontext = "[GetScriptedGui('cv_sort_by_money_supply')]"
											onclick = "[ScriptedGui.Execute(GuiScope.AddScope('player_country', GetPlayer.MakeScope).End )]"
										}
										sort_button = {
											layoutpolicy_horizontal = preferred
											align = hcenter|nobaseline
											size = { 95 20 }
											text = "CBMR"
											datacontext = "[GetScriptedGui('cv_sort_by_money_supply')]"
											onclick = "[ScriptedGui.Execute(GuiScope.AddScope('player_country', GetPlayer.MakeScope).End )]"
										}
										sort_button = {
											layoutpolicy_horizontal = preferred
											align = hcenter|nobaseline
											size = { 95 20 }
											text = "MSPM"
											datacontext = "[GetScriptedGui('cv_sort_by_national_capacity')]"
											onclick = "[ScriptedGui.Execute(GuiScope.AddScope('player_country', GetPlayer.MakeScope).End )]"
										}
									}
								}

								flowcontainer = {
									direction = vertical
									datamodel = "[GetGlobalList('monetary_systeme_list')]"
									margin_top = 10

									item = {
										button = {
											using = default_button
											size = { @panel_width 60 }

											hbox = {
												margin = { 12 0 }

												hbox = {
													layoutstretchfactor_horizontal = 2
													layoutpolicy_horizontal = expanding

													textbox = {
														layoutstretchfactor_horizontal = 1
														layoutpolicy_horizontal = expanding
														text = "[Localize(Concatenate(Scope.GetFlagName,'_monetary_systeme_icon'))]"

														margin_left = -2
														#fontsize = 17
														elide = right
														align = left|nobaseline
														parentanchor = left|nobaseline
														alwaystransparent = yes
													}

													textbox = {
														layoutstretchfactor_horizontal = 1
														layoutpolicy_horizontal = expanding
														text = "[Localize(Concatenate(Scope.GetFlagName,'_monetary_systeme_name'))]"

														#fontsize = 19
														margin_left = -25
														elide = right
														align = left|nobaseline
														parentanchor = left|nobaseline
														alwaystransparent = yes
													}
												}

												vertical_divider = {}


												vbox = {
													layoutstretchfactor_horizontal = 1
													layoutpolicy_horizontal = expanding

													tooltip = "[Localize(Concatenate(Scope.GetFlagName,'_monetary_systeme_money_value_tooltip'))]"
													using = tooltip_below

													textbox = {
														layoutstretchfactor_horizontal = 1
														layoutpolicy_horizontal = expanding
														text = "[Localize(Concatenate(Scope.GetFlagName,'_monetary_systeme_money_value'))]"

														fontsize = 15
														default_format = "#white #bold"
														#margin_left = -60
														elide = right
														align = hcenter|nobaseline
														parentanchor = left|nobaseline
														alwaystransparent = yes
													}
													textbox = {
														layoutstretchfactor_horizontal = 1
														layoutpolicy_horizontal = expanding
														text = "[Localize(Concatenate(Scope.GetFlagName,'_monetary_systeme_money_value_in_gold'))]"

														fontsize = 15
														default_format = "#white #bold"
														#margin_left = -60
														elide = right
														align = hcenter|nobaseline
														parentanchor = left|nobaseline
														alwaystransparent = yes
													}

												}


												vertical_divider = {}

												vbox = {
													layoutstretchfactor_horizontal = 1
													layoutpolicy_horizontal = expanding

													tooltip = "[Localize(Concatenate(Scope.GetFlagName,'_monetary_systeme_metal_reserve_in_gold_tooltip'))]"
													using = tooltip_below

													textbox = {
														layoutstretchfactor_horizontal = 2
														layoutpolicy_horizontal = expanding
														text = "[Localize(Concatenate(Scope.GetFlagName,'_monetary_systeme_metal_reserve'))]"

														fontsize = 20
														default_format = "#white #bold"
														#margin_left = -20
														elide = right
														align = hcenter|nobaseline
														parentanchor = left|nobaseline
														alwaystransparent = yes
													}
													# textbox = {
													# 	layoutstretchfactor_horizontal = 1
													# 	layoutpolicy_horizontal = expanding
													# 	text = "[Localize(Concatenate(Scope.GetFlagName,'_monetary_systeme_metal_reserve_in_gold'))]"

