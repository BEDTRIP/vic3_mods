												}

												vertical_divider = { }

												vbox = {
													layoutstretchfactor_horizontal = 1
													layoutpolicy_horizontal = expanding


													tooltip = "[Localize(Concatenate(Scope.GetFlagName,'_monetary_systeme_metal_reserve_per_week_tooltip'))]"
													using = tooltip_below

													textbox = {
														layoutstretchfactor_horizontal = 2
														layoutpolicy_horizontal = expanding
														text = "[Localize(Concatenate(Scope.GetFlagName,'_monetary_systeme_metal_reserve_per_week'))]"

														fontsize = 20
														default_format = "#white #bold"
														#margin_left = -12
														elide = right
														align = hcenter|nobaseline
														parentanchor = left|nobaseline
														alwaystransparent = yes
													}
