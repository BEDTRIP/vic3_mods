						#larg
						section_header_button = {

							blockoverride "left_text" {
								text = "[concept_long_term_monetary_policy]"
							}

							blockoverride "onclick" {
								onclick = "[GetVariableSystem.Toggle('large_monetary_policy')]"
								onclick = "[GetScriptedGui('large_monetary_policy_list_gerenation_ordered').Execute( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								onclick = "[GetScriptedGui('country_credit_rating_actualized').Execute( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							}

							blockoverride "onclick_showmore" {
								visible = "[Not(GetVariableSystem.Exists('large_monetary_policy'))]"
							}

							blockoverride "onclick_showless" {
								visible = "[GetVariableSystem.Exists('large_monetary_policy')]"
							}
						}
						flowcontainer = {
							using = default_list_position
							direction = vertical
							visible = "[GetVariableSystem.Exists('large_monetary_policy')]"
							#margin_bottom = 10
							margin_top = 10

							#has_tech and law
